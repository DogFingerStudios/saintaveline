  m_Script: {fileID: 11500000, guid: d04a48701bf38f44b88ebac9a648fd2c, type: 3}
  m_Name: Intro1
  m_EditorClassIdentifier: GameCore::DialogLineSO
  Speaker: {fileID: 0}
  Title: IntroLine
  Line:
  - InlineData:
      Text: Please continue on your way, sir. The evening curfew takes effect in
        exactly ten minutes.
      Audio: {fileID: 8300000, guid: ca41f4fcd597b48ee8ebfe75045354cc, type: 3}
    Asset: {fileID: 0}
  - InlineData:
      Text: Keep it moving! You've got ten minutes before the streets are locked
        down.
      Audio: {fileID: 8300000, guid: 5324d5f207d8a46b28fb7a97ab889074, type: 3}
    Asset: {fileID: 0}
  - InlineData:
      Text: Move along. Ten minutes to curfew. Don't be caught out here.
      Audio: {fileID: 8300000, guid: adb64d9618c6c4065acd61fd387ba150, type: 3}
    Asset: {fileID: 0}
